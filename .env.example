# BRH Habitat — Variables d'environnement
# Copier ce fichier en .env.local et remplir les valeurs

# === Supabase (BRH Habitat) ===
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOi...

# === Supabase (BRHCRM — chiffrage / prix) ===
VITE_BRHCRM_ANON_KEY=eyJhbGciOi...

# === IA / VPS ===
VITE_AI_API_URL=http://your-vps:8895/api/chat

# === Sentry (monitoring erreurs — optionnel) ===
VITE_SENTRY_DSN=https://xxx@sentry.io/xxx

# === Tenant (white-label — defaut: brh) ===
VITE_TENANT=brh

# =============================================
# Les variables ci-dessous sont pour les
# Edge Functions Supabase (pas le frontend)
# Configurer via: supabase secrets set KEY=VALUE
# =============================================
#
# AI_VPS_URL=http://your-vps:8895/api/chat
# BRHCRM_URL=https://YOUR_CRM_PROJECT.supabase.co
# BRHCRM_ANON_KEY=eyJhbGciOi...
# BRHCRM_SERVICE_KEY=eyJhbGciOi...
# RESEND_API_KEY=re_xxx
# EMAIL_FROM=noreply@example.com
# CRM_API_URL=https://your-crm-endpoint
# CRM_API_KEY=xxx
